# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Base URL of your PrestaShop install (no trailing slash), e.g. https://shop.example.com
PRESTASHOP_URL=https://your-shop.example.com

# Webservice API key. Generate in the back office:
#   Advanced Parameters -> Webservice -> Add new webservice key
PRESTASHOP_API_KEY=YOUR_WEBSERVICE_KEY_HERE

# Default language id used when wrapping multilingual fields (<language id="1">..</language>)
DEFAULT_LANG_ID=1

# Where the SQLite database lives (mapping profiles + import history)
DATABASE_PATH=data/app.sqlite3

# Host/port for the local server (localhost only by design)
HOST=127.0.0.1
PORT=8000
